{
  "id": "regression",
  "generator": {
    "stages": [
      {
        "virtualUsers": {
          "virtualUsers": "1",
          "requestDelay": {}
        }
      }
    ]
  },
  "rules": [
    {
      "metricName": "passAssertPct",
      "type": "TOO_LOW",
      "value": 100,
      "action": "ALERT"
    }
  ],
  "version": 3,
  "assertionGroups": [
    {
      "configs": [
        {
          "type": "httpStatusCode"
        },
        {
          "type": "httpHeaders",
          "config": {
            "headers": "Content-Type"
          }
        },
        {
          "type": "httpResponseSchema"
        },
        {
          "type": "httpResponseContentType"
        }
      ]
    }
  ],
  "responder": {
    "numReplicas": 1,
    "passthroughMode": true
  },
  "cluster": {
    "cleanup": "inventory",
    "replayMode": "full-replay",
    "sidecarTlsOut": true,
    "logLevel": "info",
    "logsCollected": true
  },
  "protected": true
}
