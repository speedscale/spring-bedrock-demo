{
  "id": "spring-bedrock-demo-capture",
  "redactlist": {
    "entries": {
      "all": [
        "authorization",
        "proxy-authorization",
        "cookie",
        "set-cookie",
        "x-amz-security-token",
        "x-api-key",
        "api-key",
        "webidentitytoken",
        "accesskeyid",
        "secretaccesskey",
        "sessiontoken",
        "password",
        "email",
        "ssn",
        "rolearn",
        "rolesessionname"
      ]
    }
  },
  "protected": false,
  "discoverPatterns": true,
  "name": "Spring Bedrock demo capture redaction",
  "transforms": [
    {
      "id": "redact-sts-accesskeyid",
      "filters": {
        "filters": [
          {
            "include": true,
            "service": "spring-bedrock-demo"
          },
          {
            "include": true,
            "namespace": "spring-bedrock-demo"
          },
          {
            "include": true,
            "tech": "STS"
          }
        ]
      },
      "extractor": {
        "type": "res_body"
      },
      "transforms": [
        {
          "type": "xml_path",
          "config": {
            "path": "//*[local-name()='AccessKeyId']/text()"
          }
        },
        {
          "type": "dlp_field",
          "config": {}
        }
      ]
    },
    {
      "id": "redact-sts-secretaccesskey",
      "filters": {
        "filters": [
          {
            "include": true,
            "service": "spring-bedrock-demo"
          },
